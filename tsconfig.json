{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@backend/*": ["core/src/backend/*"],
      "@database/*": ["core/src/database/*"],
      "@frontend/*": ["core/src/frontend/*"],
      "@apps/*": ["sandbox/apps/*"],
      "@sdk/*": ["packages/sdk/*"],
      "@scripts/*": ["scripts/*"],
      "@test/*": ["test/*"]
    },
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["bun-types"]
  },
  "include": [
    "core/src/backend/**/*.ts",
    "core/src/database/**/*.ts",
    "packages/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "portables", "core/src/frontend", ".next", "dist", "build"]
}
