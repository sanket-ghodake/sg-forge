#!/usr/bin/env bash
# ==============================================================================
# Pre-Push Quality Gate Hook (Enterprise Standard)
# ==============================================================================

cd "$(dirname "$0")/.."

echo -e "\033[0;34m🚀 Executing pre-push verification...\033[0m"

# Get current branch
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# Branch protection warning if pushing directly to main/master
if [ "$CURRENT_BRANCH" = "main" ] || [ "$CURRENT_BRANCH" = "master" ]; then
  echo -e "\033[1;33m⚠️ Warning: Pushing directly to '$CURRENT_BRANCH' branch.\033[0m"
fi

# Run fast unit tests if bun is available
BUN_BIN="bun"
if [ -f "portables/bun/bin/bun" ]; then
  BUN_BIN="$(pwd)/portables/bun/bin/bun"
fi

if command -v "$BUN_BIN" &>/dev/null; then
  echo -e "\033[0;36m🧪 Running unit tests prior to push...\033[0m"
  if ! "$BUN_BIN" test test/unit; then
    echo -e "\033[0;31m❌ Pre-push check failed: Unit tests failed!\033[0m"
    exit 1
  fi
fi

echo -e "\033[0;32m✓ Pre-push checks passed successfully.\033[0m"
exit 0
