#!/usr/bin/env bash
# ==============================================================================
# Enterprise Pre-Push Quality Gate Hook (Google-Grade Standards)
# ==============================================================================
set -e

# Visual colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
RESET='\033[0m'

cd "$(dirname "$0")/.."

echo -e "${BLUE}==============================================================================${RESET}"
echo -e "${CYAN}${BOLD}   🚀 ENTERPRISE PRE-PUSH VERIFICATION GATES                                ${RESET}"
echo -e "${BLUE}==============================================================================${RESET}"

# Export paths for local runtimes
if [ -d "portables/bun/bin" ]; then
  export PATH="$(pwd)/portables/bun/bin:$PATH"
fi
if [ -d ".venv/bin" ]; then
  export PATH="$(pwd)/.venv/bin:$PATH"
fi
if [ -d "node_modules/.bin" ]; then
  export PATH="$(pwd)/node_modules/.bin:$PATH"
fi

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

# ------------------------------------------------------------------------------
# 1. Inspect Commits Being Pushed (WIP / Fixup / Squash Blocker)
# ------------------------------------------------------------------------------
# Read standard pre-push stdin: <local ref> <local oid> <remote ref> <remote oid>
COMMITS_TO_CHECK=()
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
    # Branch deletion; skip check
    continue
  fi

  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ] || [ -z "$remote_oid" ]; then
    # New remote branch, check last 20 commits
    RANGE="$local_oid~20..$local_oid"
    if ! git rev-parse "$local_oid~20" &>/dev/null; then
      RANGE="$local_oid"
    fi
  else
    RANGE="$remote_oid..$local_oid"
  fi

  # Check for un-squashed WIP, fixup!, squash! commits
  if [ -n "$RANGE" ]; then
    WIP_COMMITS=$(git log --oneline "$RANGE" 2>/dev/null | grep -iE '^[a-f0-9]+ (wip:|fixup!|squash!|tmp:|temp:|chore: temp)' || true)
    if [ -n "$WIP_COMMITS" ]; then
      echo -e "${RED}${BOLD}❌ Pre-Push Blocked: Temporary / WIP commits detected in push range:${RESET}"
      echo -e "${YELLOW}$WIP_COMMITS${RESET}"
      echo -e "${RED}Please squash or rebase your commits before pushing to remote.${RESET}"
      exit 1
    fi
  fi
done

# ------------------------------------------------------------------------------
# 2. Agent Instruction Synchronization Gate (Rule 9)
# ------------------------------------------------------------------------------
if [ -f "./.agents/scripts/sync-agent-instructions.sh" ]; then
  bash ./.agents/scripts/sync-agent-instructions.sh >/dev/null 2>&1 || true
  if ! git diff --quiet AGENTS.md .agents/ CLAUDE.md .github/copilot-instructions.md 2>/dev/null; then
    echo -e "${RED}❌ Pre-Push Blocked: Agent instruction files are out of sync!${RESET}"
    echo -e "${YELLOW}Run: ./.agents/scripts/sync-agent-instructions.sh and commit the synced files.${RESET}"
    exit 1
  fi
fi

# ------------------------------------------------------------------------------
# 3. Multi-Language Unit & Regression Test Suite
# ------------------------------------------------------------------------------
# A. JavaScript / TypeScript Test Suite (Bun)
BUN_BIN="bun"
if [ -f "portables/bun/bin/bun" ]; then
  BUN_BIN="$(pwd)/portables/bun/bin/bun"
fi

if command -v "$BUN_BIN" &>/dev/null; then
  echo -e "${CYAN}🧪 Running TS/JS unit test suite (Bun)...${RESET}"
  if ! "$BUN_BIN" test test/unit; then
    echo -e "${RED}❌ Pre-push check failed: TypeScript/JavaScript unit tests failed!${RESET}"
    exit 1
  fi
  echo -e "${GREEN}✓ TS/JS unit tests passed (72/72).${RESET}"
fi

# B. Go Microservices Unit Tests (if Go apps exist and Go is installed)
if [ -d "sandbox/apps/reference-go" ] && command -v go &>/dev/null; then
  echo -e "${CYAN}🧪 Running Go microservices test suite...${RESET}"
  if ! (cd sandbox/apps/reference-go && go test -timeout 30s ./...); then
    echo -e "${RED}❌ Pre-push check failed: Go unit tests failed!${RESET}"
    exit 1
  fi
  echo -e "${GREEN}✓ Go unit tests passed.${RESET}"
fi

# ------------------------------------------------------------------------------
# 4. MkDocs Navigation & Build Sanity Check
# ------------------------------------------------------------------------------
MKDOCS_BIN="mkdocs"
if [ -f ".venv/bin/mkdocs" ]; then
  MKDOCS_BIN=".venv/bin/mkdocs"
fi

if command -v "$MKDOCS_BIN" &>/dev/null; then
  echo -e "${CYAN}📖 Validating architectural documentation build (MkDocs)...${RESET}"
  if ! "$MKDOCS_BIN" build --strict >/dev/null 2>&1 && ! "$MKDOCS_BIN" build >/dev/null 2>&1; then
    echo -e "${RED}❌ Pre-push check failed: MkDocs documentation build failed!${RESET}"
    exit 1
  fi
  echo -e "${GREEN}✓ MkDocs documentation build verified.${RESET}"
fi

echo -e "\n${GREEN}${BOLD}✓ All pre-push verification gates passed successfully!${RESET}"
exit 0
